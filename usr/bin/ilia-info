#!/usr/bin/env python3

import platform
import shutil
print("++++++++++ilia-info++++++++++")
print("OS :",platform.system())
print("Kernel :",platform.release())
print("CPU :",platform.processor())
print("Hostname :",platform.node())

total, used, free = shutil.disk_usage("/")

print("Disk :",round(total / (1024**3),2),"GB")
